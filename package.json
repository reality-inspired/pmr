{
  "name": "pmr",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:desktop": "npm run dev --workspace=@reality-inspired/pmr-desktop",
    "dev:web": "npm run dev --workspace=@reality-inspired/pmr-web"
  }
}
